{
  "multipart": [
    {
      "when": {
        "placement": "vertical",
        "facing": "north",
        "addon_used": "false"
      },
      "apply": {
        "model": "oritechaddonsone:block/extension_plugin_2_off"
      }
    },
    {
      "when": {
        "placement": "vertical",
        "facing": "north",
        "addon_used": "true"
      },
      "apply": {
        "model": "oritechaddonsone:block/extension_plugin_2"
      }
    },
    {
      "when": {
        "placement": "vertical",
        "facing": "east",
        "addon_used": "false"
      },
      "apply": {
        "model": "oritechaddonsone:block/extension_plugin_2_off",
