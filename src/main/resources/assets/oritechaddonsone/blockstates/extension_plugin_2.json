      }
    },
    {
      "when": {
        "placement": "vertical",
        "facing": "east",
        "addon_used": "true"
      },
      "apply": {
        "model": "oritechaddonsone:block/extension_plugin_2",
        "y": 90
      }
    },
    {
      "when": {
        "placement": "vertical",
        "facing": "south",
        "addon_used": "false"
      },
      "apply": {
        "model": "oritechaddonsone:block/extension_plugin_2_off",
        "y": 180
      }
    },
    {
      "when": {
        "placement": "vertical",
        "facing": "south",
        "addon_used": "true"
      },
      "apply": {
        "model": "oritechaddonsone:block/extension_plugin_2",
        "y": 180
      }
    },
    {
      "when": {
        "placement": "vertical",
        "facing": "west",
        "addon_used": "false"
      },
      "apply": {
        "model": "oritechaddonsone:block/extension_plugin_2_off",
